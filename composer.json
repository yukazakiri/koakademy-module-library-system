{
    "name": "koakademy/library-system",
    "description": "Library catalogue, borrowing, research papers, and rights-cleared digital editions.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-tags": "^4.10"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\LibrarySystem\\": "app/",
            "Modules\\LibrarySystem\\Database\\Factories\\": "database/factories/",
            "Modules\\LibrarySystem\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\LibrarySystem\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\LibrarySystem\\Providers\\LibrarySystemServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --compact tests/Unit/PackageContractTest.php"
    }
}
